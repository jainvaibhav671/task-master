# Postgres. `npm run deps:up` starts one on port 55432.
# Add ?connection_limit=N to size each instance's pool (see README).
DATABASE_URL="postgresql://taskmaster:taskmaster@localhost:55432/taskmaster"
PORT=3000
# Required in production. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
CORS_ORIGIN=*
# Proxy hops in front of the app, so rate limits see the real client IP.
TRUST_PROXY=1
LOG_LEVEL=info

# Required to run more than one instance. Leave empty for single-instance dev.
REDIS_URL=redis://localhost:56379

# Attachments: "local" (disk) or "s3" (AWS S3, MinIO, R2, ...)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_DOWNLOAD_URL_TTL=300
S3_CREATE_BUCKET=false
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or any other AWS credential source

# Optional: enables the /api/v1/ai endpoints
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
